            <a href="../pages/invest.html">Invest</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="container">
      <h1
        style="
          font-family: var(--font-display);
          font-size: 3.5rem;
          text-align: center;
        "
      >
        GRAND CONCERT TICKETS
      </h1>
      <p style="text-align: center; font-weight: 600">
        Tamale Sports Stadium • Gates open 6:00 PM
      </p>

      <div class="ticket-grid">
        <div class="ticket-card">
          <h2>Regular Pass</h2>
          <p>Access to General Stadium Stand & Exhibition Grounds</p>
          <div class="price-tag">GH₵ 100</div>
          <button class="btn-buy">Buy Ticket 🎟️</button>
        </div>

        <div class="ticket-card" style="border-color: var(--accent-red)">
          <h2>VIP Front Stage</h2>
          <p>Front Stage VIP Access + Complimentary Festival Fugu Sash</p>
          <div class="price-tag">GH₵ 300</div>
          <button
            class="btn-buy"
            style="background: var(--accent-red); color: white"
          >
            Buy VIP Ticket 🎟️
          </button>
        </div>

        <div class="ticket-card">
          <h2>VVIP Royal Lounge</h2>
          <p>Exclusive Royal Box Seating, Open Bar & Cultural Buffet</p>
          <div class="price-tag">GH₵ 750</div>
          <button class="btn-buy">Buy VVIP Ticket 🎟️</button>
        </div>
      </div>
