    <link
      href="https://fonts.googleapis.com/css2?family=Cabinet+Grotesk:wght@800;900&family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="style.css">
    </style>
  </head>
  <body>
    <header class="header">
      <div class="container" style="padding-top: 0; padding-bottom: 0">
        <div class="nav-wrapper">
          <a href="index.html"
            ><img
              src="WhatsApp Image 2026-09-23 at 6.21.09 AM.jpeg"
              alt="Logo"
              style="height: 60px"
          /></a>
          <nav class="nav-links">
            <a href="index.html">Home</a>
            <a href="../pages/about.html">About Fugu</a>
            <a href="../pages/programme.html">Programme</a>
            <a href="../pages/tours.html">Tour Packages</a>
            <a href="../pages/ride-north.html">Fugu Ride North</a>
